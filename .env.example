# FreeTalon environment variables — every variable the code reads.
#
# This file is a PARAMETER LIST, not a config file: the values below
# are placeholders. Real values live in env files in the
# freetalon-workspace on the boxes (mode 0600), never in this repo.
# Variables marked SECRET are layer (b) in docs/secret-hygiene.md —
# a value that would need rotation if leaked is a secret.

# --- API server and dashboard -------------------------------------------
FREETALON_API_TOKEN=placeholder-not-a-real-token        # SECRET. Bearer token the API server requires on every request.
FREETALON_API_HOST=127.0.0.1                            # Bind host for the API server (written by installer.py).
FREETALON_API_PORT=8765                                 # Bind port for the API server (written by installer.py).
FREETALON_UI_HOST=127.0.0.1                             # Bind host for the dashboard UI.
FREETALON_UI_PORT=7860                                  # Bind port for the dashboard UI.
LOCAL_WORKSPACE=/path/to/freetalon-workspace            # Workspace directory: state, logs, runs, runtime env files.

# --- Installer (written into ./.env by installer.py) ---------------------
FREETALON_INSTALL_MODE=full                             # Install mode recorded at install time.
FREETALON_NODE_ROLE=orchestrator                        # Node role recorded at install time (orchestrator or worker).
FREETALON_DOCKER_PROFILE=default                        # Docker profile selected at install time.
FREETALON_BROWSER_ENABLED=0                             # 1 enables the claw browser container at install time.
FREETALON_BOOTSTRAPPED=                                 # Bootstrap marker; set by freetalon/bootstrap.py after first-run setup.

# --- Planner LLM ----------------------------------------------------------
FREETALON_LLM_BACKEND=ollama                            # LLM backend selector (ollama or openai_compatible).
FREETALON_OLLAMA_BASE_URL=http://127.0.0.1:11434        # Ollama endpoint for the planner LLM.
FREETALON_OLLAMA_MODEL=example-model:latest             # Ollama model tag for the planner LLM.
FREETALON_LLM_TEMPERATURE=0.0                           # Sampling temperature for LLM calls.
FREETALON_LLM_THINK=0                                   # 1 enables thinking mode for reasoning models.
FREETALON_LLM_NUM_CTX=24576                             # Context window size requested per LLM call.
FREETALON_LLM_TIMEOUT_SECONDS=900                       # Per-call LLM timeout; the only bound on a runaway generation.
FREETALON_OPENAI_BASE_URL=https://example.invalid/v1    # Base URL for an OpenAI-compatible backend (optional).
FREETALON_OPENAI_MODEL=example-model                    # Model name for an OpenAI-compatible backend (optional).
FREETALON_OPENAI_API_KEY=placeholder-not-a-real-key     # SECRET. API key for an OpenAI-compatible backend (optional).
FREETALON_REPO_ROOT=                                    # Override for the repo root the loop operates on; empty = this repo.

# --- Critic ----------------------------------------------------------------
FREETALON_CRITIC_ENABLED=0                              # 1 enables the critic review seam in the loop.
FREETALON_CRITIC_OLLAMA_BASE_URL=http://127.0.0.1:11434 # Ollama endpoint for the critic judge.
FREETALON_CRITIC_OLLAMA_MODEL=example-model:latest      # Ollama model tag for the critic judge.

# --- Plan formatter ----------------------------------------------------------
FREETALON_FORMATTER_ENABLED=0                           # 1 enables the plan formatter stage.
FREETALON_FORMATTER_OLLAMA_BASE_URL=http://127.0.0.1:11434 # Ollama endpoint for the formatter.
FREETALON_FORMATTER_OLLAMA_MODEL=example-model:latest   # Ollama model tag for the formatter.

# --- Content pipeline --------------------------------------------------------
CONTENT_PIPELINE_TOKEN=placeholder-not-a-real-token     # SECRET. Bearer token for the inertiald.com internal content API.
CONTENT_SITE_BASE_URL=http://127.0.0.1:3000             # Base URL of the site app the content generator talks to.
CONTENT_OLLAMA_MODEL=example-model:latest               # Model tag for content draft generation.
CONTENT_VISION_MODEL=example-model:latest               # Model tag for photo vision descriptions.
FREETALON_FFMPEG=ffmpeg                                 # ffmpeg binary (content video rendering).
FREETALON_FFPROBE=ffprobe                               # ffprobe binary (content video verification).

# --- Claw browser container (set by installer.py, not operator env) ---------
SCREENSHOTS_DIR=/screenshots                            # Screenshot directory inside the claw container.
CLAW_PORT=8080                                          # Port the claw browser serves on inside its container.
LOG_LEVEL=INFO                                          # Log level for the claw browser process.
